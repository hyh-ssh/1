# 必填：32 字节 AES-256 密钥，以 hex 或 base64 编码。
GATEWAY_MASTER_KEY=
# 仅在轮换密钥时需要：逗号分隔的旧主密钥列表。
GATEWAY_PREVIOUS_MASTER_KEYS=
# 仅在数据库中还没有任何用户时使用。
GATEWAY_ADMIN_USER=admin
GATEWAY_ADMIN_PASSWORD=

# 主 OIDC Provider 凭据：仅用于首次播种（配置记录不存在时写入一次）。
# 播种之后由管理员在控制台「设置 → 主 OIDC Provider」维护；清空配置后重启不会用这里的值覆盖回来。
# 回调地址须登记为 <网关地址>/api/auth/oidc/callback，生产环境用 HTTPS 并同时设置 GATEWAY_COOKIE_SECURE=true。
GATEWAY_OIDC_ISSUER=
GATEWAY_OIDC_CLIENT_ID=
GATEWAY_OIDC_CLIENT_SECRET=
GATEWAY_OIDC_REDIRECT_URL=
GATEWAY_OIDC_DISPLAY_NAME=企业账号

POSTGRES_DB=llm_gateway
POSTGRES_USER=gateway
POSTGRES_PASSWORD=change-me
# 可选；省略时 Compose 会依据 POSTGRES_* 变量推导该 URL。

GATEWAY_BUSINESS_TZ=Asia/Shanghai
GATEWAY_CONTENT_LOGGING=false
GATEWAY_CONTENT_LOG_MAX_BYTES=1048576
GATEWAY_COOKIE_SECURE=false
GATEWAY_ALLOW_PRIVATE_UPSTREAMS=false
GATEWAY_LISTEN_ADDR=:8080
GATEWAY_SHUTDOWN_TIMEOUT=10s
GATEWAY_SESSION_TTL=24h
GATEWAY_LOG_RETENTION_DAYS=0
BACKEND_PORT=8080
FRONTEND_PORT=4173
